[alias]
	a = add -A
	aa = add -A
	dc = diff -F --cached
	co = checkout
	ci = commit
	st = status
	br = branch
	hist  = log -F --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
[user]
	name = Thuy Luong
	email = thuy419@gmail.com
[core]
  editor = /usr/bin/vim
	excludesfile = ~/.gitignore
[merge]
  ff = only
	tool = Kaleidoscope
[push]
  default = matching
[color]
  ui = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[diff]
	tool = Kaleidoscope
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
	trustExitCode = true
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
[mergetool]
	prompt = false
